{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenzhe223-tech/davy-event/blob/main/schemas/event.schema.json",
  "title": "DAVYLAB Event",
  "type": "object",
  "required": ["title", "source_platform", "source_url", "retrieved_at", "verification_status"],
  "properties": {
    "event_id": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "start_datetime": {"type": ["string", "null"], "format": "date-time"},
    "end_datetime": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": ["string", "null"]},
    "venue_name": {"type": ["string", "null"]},
    "address": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "price": {"type": ["string", "number", "null"]},
    "currency": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"]},
    "organizer": {"type": ["string", "null"]},
    "registration_url": {"type": ["string", "null"], "format": "uri"},
    "source_platform": {"type": "string"},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "verification_status": {"enum": ["verified", "source_claim", "uncertain", "expired", "unavailable"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
